# Environment Configuration Template
# Copy this file to .env and update with your production values
# The .env file will NOT be committed to git

# Server Configuration
LEXICON_PORT=36568
SERVER_ADDRESS=0.0.0.0

# Database Configuration
# Format: jdbc:hsqldb:hsql://HOST:PORT/DATABASE
DATABASE_URL=jdbc:hsqldb:hsql://localhost:9002/mydb

# File Upload Configuration
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=100MB
UPLOAD_DIR=./uploads

# YouTube Download Configuration (yt-dlp)
# REQUIRED for YouTube URL downloads to work
# Path to your YouTube cookies file (export from browser)
# See README.md for instructions on exporting cookies
YTDLP_COOKIES_PATH=/path/to/your/youtube_cookies.txt

# Production Example:
# DATABASE_URL=jdbc:hsqldb:hsql://192.168.1.100:9002/mydb
# YTDLP_COOKIES_PATH=/opt/lexicon/youtube_cookies.txt

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=<your-generated-public-key>
VAPID_PRIVATE_KEY=<your-generated-private-key>
VAPID_SUBJECT=mailto:admin@example.com

# Android app self-update (private APK sideload)
# Keep metadata/download private by default and authenticate with bearer/session.
APP_UPDATE_VERSION_CODE=2
APP_UPDATE_VERSION_NAME=0.2.0
APP_UPDATE_DOWNLOAD_URL=https://api.alex-dyakin.com/api/app/download/latest
APP_UPDATE_APK_PATH=/opt/lexicon/releases/lexicon-latest.apk
APP_UPDATE_CRITICAL=false
APP_UPDATE_CHANGELOG=Bug fixes and performance improvements.
APP_UPDATE_SHA256=
APP_UPDATE_PUBLIC_METADATA=false
APP_UPDATE_PUBLIC_DOWNLOAD=false
