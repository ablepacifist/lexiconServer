# =============================================================================
# lexiconServer environment template - copy to `.env` for standalone use.
#
# LAYERING (lowest -> highest priority), via spring.config.import in
# src/main/resources/application.properties:
#   1. this file's values, copied to `.env` (git-ignored) - runs standalone
#   2. the monorepo root `.env` (same key names) - OVERRIDES this module's own
#      values; found via $MASTER_ENV_FILE, else ../.env from this directory
#   3. real process environment variables - highest priority
#
# Only the keys this module actually reads are listed here. See the root
# `.env.example` (in the repo root) for the full registry and derivation
# rules (e.g. CORS also always allows http://LAN_HOST:* and
# http://PLAYIT_HOST:* automatically once those two keys are set).
#
# Format: KEY=value, one per line, no quotes, no inline comments, forward
# slashes in paths (Spring reads this as a .properties file).
# =============================================================================

# ----- Server ------------------------------------------------------------
LEXICON_PORT=36568
SERVER_ADDRESS=0.0.0.0

# ----- Database (HSQLDB) --------------------------------------------------
# Read both by Spring (via spring.config.import) and directly by
# lexicon.utils.DatabaseConfig for the ~13 classes that open JDBC
# connections outside Spring DI - see DatabaseUrlEnvironmentPostProcessor.
DATABASE_URL=jdbc:hsqldb:hsql://localhost:9002/mydb

# ----- CORS ----------------------------------------------------------------
# Exact origins, comma-separated, no spaces.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://alex-dyakin.com
# Wildcard patterns (Spring's * syntax, not regex), comma-separated, no spaces.
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.alex-dyakin.com,http://*.playit.pub:*,http://*.with.playit.plus:*,http://*.gl.at.ply.gg:*,http://localhost:*,capacitor://localhost,https://localhost
# Optional: when set, http://<value>:* is added to the allowed origin
# patterns automatically (LAN and PlayIt tunnel access without listing ports).
LAN_HOST=
PLAYIT_HOST=

# ----- File upload / storage ------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=100MB

# yt-dlp cookies (required for age-restricted YouTube content)
YTDLP_COOKIES_PATH=./cookies.txt

# ----- Lexi voice relay ------------------------------------------------------
# LexiconServer reaches Lexi at 127.0.0.1:LEXI_PORT unless LEXI_BASE_URL is
# set directly. LEXI_TOOL_TOKEN must equal Lexi's own .tool_token.
LEXI_PORT=8765
LEXI_BASE_URL=
LEXI_TOOL_TOKEN=

# ----- Mumble Bridge (avatar proxy) ------------------------------------------
PUBLIC_BRIDGE_URL=https://voice.alex-dyakin.com

# ----- Public hostname (used to compose the app-update download URL) --------
PUBLIC_LEXICON_URL=https://api.alex-dyakin.com

# ----- Web Push (VAPID) - generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ----- Android app self-update ------------------------------------------------
APP_UPDATE_VERSION_CODE=1
APP_UPDATE_VERSION_NAME=0.1.0
# Leave unset to compose from PUBLIC_LEXICON_URL + /api/app/download/latest.
APP_UPDATE_DOWNLOAD_URL=
APP_UPDATE_APK_PATH=./releases/lexicon-latest.apk
APP_UPDATE_CRITICAL=false
APP_UPDATE_CHANGELOG=
APP_UPDATE_SHA256=
APP_UPDATE_PUBLIC_METADATA=false
APP_UPDATE_PUBLIC_DOWNLOAD=false
